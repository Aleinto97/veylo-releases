rules_version = '2';
// Veylo's accounts (src/backend/account.rs). Paste into Firebase → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each account's synced titles and episodes: only that account reads or writes them.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // A computer's sign-in request (its QR code): the computer, signed in for the moment without
    // an account, creates and reads its own; a signed-in phone may only add the sealed answer.
    match /links/{link} {
      allow create: if request.auth != null && request.resource.data.asker == request.auth.uid
        && request.resource.data.keys().hasOnly(['asker', 'created']);
      allow read, delete: if request.auth != null && resource.data.asker == request.auth.uid;
      allow update: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sealed'])
        && resource.data.created > request.time - duration.value(15, 'm');
    }
  }
}
